-- ============================================================
-- 爆炸猫（Exploding Kittens）在线桌游 - Redis 存储结构
-- 数据库: Redis
-- 说明: 游戏状态热备、房间元数据、会话缓存、速率限制
-- ============================================================
-- 用法: 将本文件中的命令通过 redis-cli 管道执行，或逐条执行
--       redis-cli < redis/001_init.redis
-- ============================================================

-- ============================================================
-- 1. 游戏状态快照（Game State Snapshot）
-- ----------------------------------------------------------
-- 文档 4.1 / 4.2 节：游戏状态的热备，每次状态变更后异步写入。
-- 一个房间对应一个 Key，Value 是整个游戏状态的 JSON 序列化。
-- Redis 存储的是序列化后的卡牌对象，不是数据库行记录。
-- TTL 24 小时自动清理已结束/废弃的房间。
-- ============================================================

-- 示例：初始状态
-- SET game_state:room:r_abc123 '{
--   "deck": [
--     {"id":"cat_001","type":"cat_card","name":"猫牌"},
--     {"id":"defuse_01","type":"defuse","name":"拆解"}
--   ],
--   "discard_pile": [],
--   "hands": {
--     "u_001": [{"id":"cat_002","type":"cat_card","name":"猫牌"}],
--     "u_002": [{"id":"skip_01","type":"skip","name":"跳过"}]
--   },
--   "turn": {
--     "current_player_id": "u_001",
--     "player_order": ["u_001","u_002"],
--     "direction": 1,
--     "pending_draws": 0,
--     "phase": "action"
--   },
--   "action_stack": [],
--   "phase": "playing",
--   "round_count": 1
-- }'
-- EXPIRE game_state:room:r_abc123 86400

-- Key Pattern:  game_state:room:{room_id}
-- Type:         String
-- TTL:          86400s (24h)
-- 写入时机:    每次游戏状态变更后异步写入
-- 读取时机:    服务重启时从 Redis 恢复房间状态
-- 删除时机:    房间解散时主动 DEL，或 TTL 到期自动过期


-- ============================================================
-- 2. 房间元数据（Room Metadata）
-- ----------------------------------------------------------
-- 用 Hash 而非 String，方便单独读/写单个字段
-- （如 status、player_count），无需反序列化整个 JSON。
-- ============================================================

-- 示例：创建房间
-- HSET room:r_abc123 \
--   name            "欢乐局" \
--   owner_id        "u_abc123" \
--   status          "waiting" \
--   max_players     "5" \
--   player_count    "0" \
--   created_at      "1712345678"
-- EXPIRE room:r_abc123 86400

-- 示例：更新房间状态
-- HSET room:r_abc123 status "playing" player_count "4"

-- 示例：读取单独字段
-- HGET room:r_abc123 status

-- Key Pattern:  room:{room_id}
-- Type:         Hash
-- TTL:          86400s (24h)
-- Field 说明:
--   name          房间名称
--   owner_id      房主玩家 ID
--   status        房间状态: waiting / playing / finished
--   max_players   最大玩家数
--   player_count  当前在线玩家数
--   created_at    创建时间戳（Unix 秒）
-- 写入时机:    创建/更新房间时
-- 读取时机:    查询房间列表、房间详情时


-- ============================================================
-- 3. 邀请码 → 房间 ID 映射（Invite Code Index）
-- ----------------------------------------------------------
-- 6 位邀请码用于快速加入房间，查询频率高。
-- 用 String 即可，无需复杂结构。
-- ============================================================

-- 示例：创建邀请码映射
-- SET invite_code:A1B2C3 "r_abc123"
-- EXPIRE invite_code:A1B2C3 86400

-- 示例：通过邀请码查询房间 ID
-- GET invite_code:A1B2C3

-- Key Pattern:  invite_code:{code}
-- Type:         String
-- TTL:          86400s (24h)
-- Value:        room_id
-- 写入时机:    创建房间时
-- 读取时机:    玩家通过邀请码加入房间时
-- 删除时机:    房间解散时主动 DEL，或 TTL 到期


-- ============================================================
-- 4. 房间在线玩家集合（Room Players Set）
-- ----------------------------------------------------------
-- Set 天然支持去重和成员快速判断（SISMEMBER），
-- 比遍历 JSON 或 Hash 更高效。
-- ============================================================

-- 示例：玩家加入房间
-- SADD room_players:r_abc123 "u_001" "u_002"
-- EXPIRE room_players:r_abc123 86400

-- 示例：判断玩家是否在房间中
-- SISMEMBER room_players:r_abc123 "u_001"

-- 示例：获取房间所有玩家
-- SMEMBERS room_players:r_abc123

-- 示例：玩家退出房间
-- SREM room_players:r_abc123 "u_001"

-- Key Pattern:  room_players:{room_id}
-- Type:         Set
-- TTL:          86400s (24h)
-- Members:      player_id 字符串
-- 写入时机:    玩家加入房间时
-- 读取时机:    查询房间在线玩家、广播目标列表
-- 删除时机:    玩家退出、房间解散时


-- ============================================================
-- 5. 玩家会话缓存（Session Cache）
-- ----------------------------------------------------------
-- 配合 JWT 做服务端会话缓存，避免每次请求都查 PostgreSQL。
-- TTL 与 JWT Token 过期时间对齐。
-- ============================================================

-- 示例：用户登录成功
-- SET session:eyJhbGciOiJIUzI1NiIs... '{
--   "user_id": "u_abc123",
--   "nickname": "玩家A"
-- }'
-- EXPIRE session:eyJhbGciOiJIUzI1NiIs... 259200

-- 示例：验证 Token 并获取用户信息
-- GET session:eyJhbGciOiJIUzI1NiIs...

-- 示例：用户登出（主动失效）
-- DEL session:eyJhbGciOiJIUzI1NiIs...

-- Key Pattern:  session:{jwt_token}
-- Type:         String
-- TTL:          259200s (72h，与 JWT 过期时间一致)
-- Value:        {"user_id":"...","nickname":"..."} JSON
-- 写入时机:    用户登录/注册成功时
-- 读取时机:    每次 HTTP/WS 请求鉴权时
-- 删除时机:    用户登出、Token 刷新旧 Token 失效时


-- ============================================================
-- 6. 速率限制（Rate Limiter）
-- ----------------------------------------------------------
-- 文档 7.5 节：防重放设计，防止接口被高频调用。
-- 使用 INCR + EXPIRE 实现滑动窗口计数。
-- 支持按 IP 和按操作类型分别限流。
-- ============================================================

-- 示例：玩家出牌操作限流（每秒最多 5 次）
-- INCR ratelimit:192.168.1.1:play_card
-- EXPIRE ratelimit:192.168.1.1:play_card 1
-- （返回计数 > 5 时拒绝请求）

-- 示例：登录接口限流（每分钟最多 10 次）
-- INCR ratelimit:192.168.1.1:login
-- EXPIRE ratelimit:192.168.1.1:login 60
-- （返回计数 > 10 时拒绝请求）

-- Key Pattern:  ratelimit:{ip}:{action}
-- Type:         String（用作计数器）
-- TTL:          窗口大小，按操作类型配置
--                 play_card  -> 1s, 上限 5 次
--                 login      -> 60s, 上限 10 次
--                 register   -> 3600s, 上限 3 次
-- Value:        计数（INCR 自增）
-- 写入时机:    每次操作发生时 INCR
-- 读取时机:    每次操作前检查计数是否超限
-- 删除时机:    TTL 到期自动重置


-- ============================================================
-- 7. 房间操作锁（Distributed Lock）
-- ----------------------------------------------------------
-- 防止同一房间的并发操作冲突（如两个玩家同时出牌）。
-- 文档 4.3 节：每房间一个 goroutine + channel 串行化。
-- 分布式场景下，此锁用于确保同一房间的请求路由到同一个实例。
-- ============================================================

-- 示例：尝试获取房间锁（NX = 仅在 Key 不存在时设置）
-- SET lock:room:r_abc123 "server_01" NX EX 30

-- 示例：释放房间锁
-- DEL lock:room:r_abc123
-- （或使用 Lua 脚本确保只有持有者能释放）

-- Key Pattern:  lock:room:{room_id}
-- Type:         String
-- TTL:          30s（防止死锁，超时自动释放）
-- Value:        持有锁的服务器实例 ID
-- 写入时机:    请求路由到房间时尝试获取
-- 读取时机:    判断房间是否被其他实例处理
-- 删除时机:    操作完成或锁超时


-- ============================================================
-- 有效期总览
-- ============================================================
-- Key 模式                          TTL      说明
-- game_state:room:{room_id}         86400s   游戏状态快照
-- room:{room_id}                    86400s   房间元数据
-- invite_code:{code}                86400s   邀请码映射
-- room_players:{room_id}            86400s   房间在线玩家
-- session:{jwt_token}               259200s  会话缓存（72h）
-- ratelimit:{ip}:{action}          窗口大小  速率限制计数
-- lock:room:{room_id}               30s      分布式锁


-- ============================================================
-- 与文档三层存储架构的对应关系
-- ============================================================
-- 内存（Primary）     ← 游戏进行中所有状态，Go struct
--                     ↓ 异步写入
-- Redis（热备）       ← 本文件定义的所有 Key
--                     ↓ 游戏结束后写入
-- PostgreSQL（归档）  ← sql/001_init.sql 定义的所有表
--
-- 文档 4.1 节：三层存储架构
-- 文档 4.2 节：Redis 存储内容（牌库、手牌、弃牌堆、回合状态+动作栈）
-- 文档 4.3 节：每房间一个 goroutine + channel 串行化
-- 文档 7.5 节：防重放设计